<%- include('partials/header.ejs') %>

<div class="relative w-full min-h-screen flex flex-col">
  <img src="/assets/background.jpg" class="absolute inset-0 w-full object-cover" alt="Background Image" loading="lazy">

  <div class="relative bg-white sm:rounded-t-[50px] rounded-t-[30px] w-full flex-1" style="top: 100px;">

    <!-- all web content -->
    <div class="pt-20 p-8 md:mt-[-20px] md:pt-20 md:p-16 lg:mt-[-40px] lg:pt-28 lg:p-24 xl:mt-[-60px] xl:pt-36 xl:p-32">

      <!-- starting content -->
      <div class="pb-5">
        <h1 class="font-bold sm:text-4xl text-2xl text-brown-1 pb-2">
          <span class="text-brown-1">Bizarrebeam</span>'s Corner
        </h1>

        <p class="text-justify sm:text-base text-xs sm:leading-relaxed leading-tight">
          A tiny corner of my reading journal. Would you want to read it too? I give my own summaries, highlight parts from the book, and link them to <a href="https://openlibrary.org/" target="_blank" rel="noopener noreferrer" class="font-bold text-brown-2 hover:text-brown-1 underline">OpenLibrary</a> if you want to read more descriptions of the book. This page will continuously update as I read more. Flip it, let's go!
        </p>
      </div>

      <!-- Admin Control Panel -->
      <% if (isAdmin) { %>
        <div class="bg-brown-3 rounded-2xl p-6 mb-8 border border-brown-2">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center space-y-4 sm:space-y-0">
            <div class="flex items-center space-x-3">
              <div class="bg-brown-1 rounded-full p-2">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-brown-1 text-xl">Admin Panel</h3>
                <p class="text-brown-2 text-sm">Manage Your Book Collection</p>
              </div>
            </div>
            <div class="flex flex-col sm:flex-row space-y-2 sm:space-y-0 sm:space-x-4 w-full sm:w-auto">
              <a href="/compose" class="bg-brown-1 hover:bg-brown-2 text-white font-bold py-3 px-6 rounded-full transition-all duration-300 text-sm hover:scale-105 active:scale-95 flex items-center justify-center space-x-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
                <span>Add New Book</span>
              </a>
              <form action="/admin/logout" method="POST" class="inline">
                <button type="submit" class="bg-brown-2 hover:bg-red-500 text-white font-bold py-3 px-6 rounded-full transition-all duration-300 text-sm hover:scale-105 active:scale-95 flex items-center justify-center space-x-2 w-full sm:w-auto">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                  </svg>
                  <span>Logout</span>
                </button>
              </form>
            </div>
          </div>
        </div>
      <% } %>

      <!-- sorting buttons -->
      <div class="mb-8">
        <p class="font-bold text-brown-1 pb-1 sm:text-base text-sm">Sort By</p>
        <div class="flex">
          <button id="title" class="bg-brown-2 text-white font-bold sm:py-2 sm:px-4 px-2 h-7 sm:h-10 sm:text-base text-xs rounded-full hover:bg-brown-1 hover:scale-105 active:scale-95 transition-all duration-150 ease-in-out mr-3" onclick="sortBooks('title')">
            Title
          </button>
          <button id="recently-read" class="bg-brown-2 text-white font-bold sm:py-2 sm:px-4 px-2 h-7 sm:h-10 sm:text-base text-xs rounded-full hover:bg-brown-1 hover:scale-105 active:scale-95 transition-all duration-150 ease-in-out" onclick="sortBooks('recently-read')">
            Recently Read
          </button>
        </div>
      </div>

      <!-- books card grid -->
      <div class="grid grid-cols-1 custom-1330:grid-cols-2 gap-6">
        <% books.forEach(book => { %>
          <div class="book-card-container relative mt-8">
            <!-- book cover - positioned to pop out only from top -->
            <div class="book-cover-pop absolute left-4 top-0 z-10 transform sm:-translate-y-10 -translate-y-6">
              <img src="<%= book.cover_url %>" alt="book cover" class="sm:w-44 w-28 sm:rounded-2xl rounded-xl book-cover-height" loading="lazy">
            </div>
            
            <!-- main card content -->
            <div class="bg-brown-3 sm:rounded-2xl rounded-xl sm:p-5 p-3 flex">
              <!-- spacer for book cover -->
              <div class="flex-none sm:w-44 w-28 mr-4"></div>
              
              <!-- content section -->
              <div class="flex-grow book-content-height flex flex-col justify-between">
                <div>
                  <h2 class="sm:text-2xl text-base font-bold text-brown-1 sm:leading-relaxed leading-tight"><%= book.title %></h2>
                  <p class="sm:text-lg text-sm font-bold text-brown-2 sm:leading-relaxed leading-tight"><%= book.author %></p>
                  <p class="sm:text-base text-xxxs text-brown-2 text-right sm:mt-1 mt-2 sm:leading-relaxed leading-tight">Finished at <%= book.finished_month_year %></p>
                  
                  <!-- summary with 2-line limit -->
                  <div class="sm:mt-0 mt-1 text-brown-1 sm:text-base text-xxs">
                    <p class="line-clamp-2 text-justify sm:leading-relaxed leading-tight"><%= book.summary_text %></p>
                    <a href="/review/<%= book.book_id %>" class="text-peach hover:text-brown-2">...peek more</a>
                  </div>
                </div>

                <!-- buttons -->
                <div class="flex flex-grow-0 justify-end space-x-2 sm:space-x-4 sm:mt-4 mt-2 items-center">
                  <a href="https://openlibrary.org/isbn/<%= book.isbn %>" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center bg-brown-2 hover:bg-brown-1 hover:scale-105 active:scale-95 text-white font-bold sm:py-2 sm:px-4 py-0.5 px-2 h-6 sm:h-10 sm:text-base text-xxxs sm:rounded-full rounded-full transition-all duration-150 ease-in-out leading-none whitespace-nowrap">
                    OpenLibrary
                  </a>
                  <a href="/review/<%= book.book_id %>" class="flex items-center justify-center bg-brown-1 hover:bg-brown-2 hover:scale-105 active:scale-95 text-white font-bold sm:py-2 sm:px-4 py-0.5 px-2 h-6 sm:h-10 sm:text-base text-xxxs sm:rounded-full rounded-full transition-all duration-150 ease-in-out leading-none whitespace-nowrap">
                    Read My Notes
                  </a>
                </div>

                <!-- Admin controls for each book -->
                <% if (isAdmin) { %>
                  <div class="flex flex-grow-0 justify-start space-x-3 mt-4 pt-4 border-t border-brown-2/30">
                    <button onclick="editBook('<%= book.book_id %>')" class="bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded-full text-xs sm:text-sm transition-all duration-200 hover:scale-105 active:scale-95 flex items-center space-x-2">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                      </svg>
                      <span>Edit</span>
                    </button>
                    <button onclick="deleteBook('<%= book.book_id %>', '<%= book.title %>')" class="bg-red-500 hover:bg-red-600 text-white font-semibold py-2 px-4 rounded-full text-xs sm:text-sm transition-all duration-200 hover:scale-105 active:scale-95 flex items-center space-x-2">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                      </svg>
                      <span>Delete</span>
                    </button>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

    </div>

  </div>
</div>

<style>
/* custom breakpoint for 1330px */
@media (min-width: 1330px) {
  .custom-1330\:grid-cols-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* book card hover effects */
.book-card-container:hover .book-cover-pop {
  transform: translateY(-14px);
  transition: transform 0.3s ease;
}

.book-cover-pop {
  transition: transform 0.3s ease;
}

/* responsive hover effects */
@media (max-width: 639px) {
  .book-card-container:hover .book-cover-pop {
    transform: translateY(-10px);
  }
}

/* book cover same height as content */
.book-cover-height {
  height: auto;
}

.book-content-height {
  min-height: 200px;
}

/* line clamping */
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* responsive adjustments */
@media (max-width: 639px) {
  .book-content-height {
    min-height: 140px;
  }
}
</style>

<script>
  
  function sortBooks(criteria) {
    // redirect to the same page with the sort parameter
    window.location.href = `/?sort=${criteria}`;
  }

  // Admin functions
  function editBook(bookId) {
    window.location.href = `/admin/edit/${bookId}`;
  }
  
  function deleteBook(bookId, bookTitle) {
    if (confirm(`Are you sure you want to delete "${bookTitle}"? This action cannot be undone.`)) {
      fetch(`/admin/delete/${bookId}`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        }
      })
      .then(response => {
        if (response.ok) {
          location.reload();
        } else {
          alert('Error deleting book');
        }
      })
      .catch(error => {
        console.error('Error:', error);
        alert('Error deleting book');
      });
    }
  }
</script>

</body>