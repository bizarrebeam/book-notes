<%- include('partials/header.ejs') %>

<div class="relative w-full min-h-screen flex flex-col">
  <img src="/assets/background.jpg" class="absolute inset-0 w-full object-cover" alt="Background Image" loading="lazy">

  <div class="relative bg-white rounded-t-[50px] w-full flex-1" style="top: 100px;">

    <!-- all web content -->
    <div class="pt-20 p-8 md:mt-[-20px] md:pt-20 md:p-16 lg:mt-[-40px] lg:pt-28 lg:p-24 xl:mt-[-60px] xl:pt-36 xl:p-32">

      <!-- starting content -->
      <div class="pb-5">
        <h1 class="font-bold sm:text-4xl text-2xl text-brown-1 pb-2">
          <a href="/about" class="hover:text-brown-2 transition ease-in-out">bizarrebeam</a>'s corner
        </h1>

        <p class="text-justify sm:text-base text-xs">
          a tiny corner of my reading journal. would you want to read it too? i give my own summaries, highlight parts from the book, and link them to <a href="https://openlibrary.org/" class="font-bold text-brown-2 hover:text-brown-1 underline">openlibrary</a> if you want to read more descriptions of the book. this page will continuously update as i read more. flip it, let's go!
        </p>
      </div>

      <!-- sorting buttons -->
      <div>
        <p class="font-bold text-brown-1 pb-1 sm:text-base text-sm">sort by</p>
        <div class="flex">
          <button id="title" class="bg-brown-2 text-white font-bold sm:py-2 sm:px-4 px-2 h-7 sm:h-10 sm:text-base text-xs rounded-full hover:bg-brown-1 transition ease-in-out mr-3" onclick="sortBooks('title')">title</button>
          <button id="recently-read" class="bg-brown-2 text-white font-bold sm:py-2 sm:px-4 px-2 h-7 sm:h-10 sm:text-base text-xs rounded-full hover:bg-brown-1 transition ease-in-out" onclick="sortBooks('recently-read')">recently read</button>
        </div>
      </div>

      <!-- books card -->
      <div class="mt-5">
        <% books.forEach(book => { %>
          <div class="bg-brown-3 rounded-2xl sm:p-5 p-3 w-full mb-5">
            <div class="flex">

              <!-- book cover -->
              <div class="flex-none">
                <img src="<%= book.cover_url %>" alt="book cover" class="sm:w-32 w-24 h-auto rounded-lg" loading="lazy">
              </div>

              <!-- content section -->
              <div class="ml-4 flex-grow">
                <h2 class="sm:text-2xl text-base font-bold text-brown-1"><%= book.title %></h2>
                <p class="sm:text-lg text-sm font-bold text-brown-2"><%= book.author %></p>
                <p class="sm:text-base text-xxxs text-brown-2 text-right sm:mt-1 mt-3">finished at <%= book.finished_month_year %></p>
                <div class="mt-1 sm:mt-0 text-brown-1 sm:text-base text-xxs">
                  <p class="sm:line-clamp-4 line-clamp-5 text-justify"><%= book.summary_text %></p>
                  <a href="/review/<%= book.book_id %>" class="text-peach hover:text-brown-2">...peek more</a>
                </div>
              </div>

            </div>

            <div class="flex flex-grow-0 justify-end space-x-4 mt-4 items-center">
              <a href="https://openlibrary.org/isbn/<%= book.isbn %>" class="flex items-center justify-center bg-brown-2 hover:bg-brown-1 text-white font-bold sm:py-2 sm:px-4 px-2 h-7 sm:h-10 sm:text-base text-xs rounded-full transition duration-150 leading-none">openlibrary</a>
              <a href="/review/<%= book.book_id %>" class="flex items-center justify-center bg-brown-1 hover:bg-brown-2 text-white font-bold sm:py-2 sm:px-4 px-2 h-7 sm:h-10 sm:text-base text-xs rounded-full transition duration-150 leading-none">read my notes</a>
            </div>
          </div>
        <% }) %>
      </div>

    </div>

  </div>
</div>

<script>
  function sortBooks(criteria) {
    // redirect to the same page with the sort parameter
    window.location.href = `/?sort=${criteria}`;
  }
</script>

</body>
