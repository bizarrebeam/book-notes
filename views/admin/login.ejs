<%- include('../partials/header.ejs') %>

<div class="min-h-screen flex items-center justify-center bg-brown-3 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full">
        <!-- Back to public site button -->
        <div class="mb-6 sm:mb-8">
            <a href="/" class="inline-flex items-center text-brown-1 hover:text-brown-2 transition duration-150 text-sm sm:text-base">
                <svg class="w-3 h-3 sm:w-4 sm:h-4 mr-1 sm:mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Back to public site
            </a>
        </div>

        <!-- Login container -->
        <div class="bg-white rounded-2xl shadow-xl p-6 sm:p-8 border border-brown-2">
            <div class="text-center mb-6 sm:mb-8">
                <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-brown-1 mb-2">
                    Hm, you're Adel, right?
                </h2>
                <p class="text-brown-2 text-xs sm:text-sm">
                    Cause this is definitely Adelya's own library to sort...
                </p>
            </div>

            <% if (typeof error !== 'undefined') { %>
            <div class="bg-red-50 border border-red-200 text-red-700 px-3 sm:px-4 py-2 sm:py-3 rounded-lg mb-4 sm:mb-6">
                <div class="flex">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5 text-red-400 mr-1 sm:mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="text-xs sm:text-sm"><%= error %></span>
                </div>
            </div>
            <% } %>

            <form class="space-y-4 sm:space-y-6" action="/admin/login" method="POST">
                <div>
                    <label for="username" class="block text-xs sm:text-sm font-medium text-brown-1 mb-2">
                        Username
                    </label>
                    <input 
                        id="username" 
                        name="username" 
                        type="text" 
                        required 
                        autofocus
                        class="w-full px-3 sm:px-4 py-2 sm:py-3 text-sm sm:text-base bg-white border-2 border-brown-2 rounded-xl text-brown-1 placeholder-brown-2 focus:outline-none focus:ring-0 focus:border-brown-1 transition duration-200 hover:border-brown-1"
                        placeholder="Enter your username"
                    >
                </div>

                <div>
                    <label for="password" class="block text-xs sm:text-sm font-medium text-brown-1 mb-2">
                        Password
                    </label>
                    <input 
                        id="password" 
                        name="password" 
                        type="password" 
                        required 
                        class="w-full px-3 sm:px-4 py-2 sm:py-3 text-sm sm:text-base bg-white border-2 border-brown-2 rounded-xl text-brown-1 placeholder-brown-2 focus:outline-none focus:ring-0 focus:border-brown-1 transition duration-200 hover:border-brown-1"
                        placeholder="Enter your password"
                    >
                </div>

                <button 
                    type="submit" 
                    class="w-full bg-brown-1 text-white py-2 sm:py-3 px-4 text-sm sm:text-base rounded-xl font-medium hover:bg-brown-2 focus:outline-none focus:ring-4 focus:ring-brown-1 focus:ring-opacity-50 transition duration-200 transform hover:scale-[1.02] active:scale-[0.98]"
                >
                    verify identity
                </button>
            </form>
        </div>

    </div>
</div>

</body>
</html>