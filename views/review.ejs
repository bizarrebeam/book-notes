<%- include('partials/header.ejs') %>

<!-- background image -->
<div class="h-screen fixed inset-0 overflow-hidden z-0">
    <img src="<%= book.cover_url %>" alt="Book Cover Background" class="h-full background-blur" loading="lazy">
</div>

<!-- back button -->
<a href="/" class="back-button absolute top-7 left-7 bg-white rounded-full lg-custom:w-10 lg-custom:h-10 w-8 h-8 flex items-center justify-center shadow-lg hover:bg-gray-200 active:bg-gray-300 transition cursor-pointer z-30 overflow-hidden">
    <i class="fa fa-arrow-left lg-custom:text-xl text-lg text-brown-1 transition-transform duration-200"></i>
    <span class="ripple"></span>
</a>

<!-- left content -->
<div class="fixed top-0 left-0 lg-custom:h-screen h-[45%] lg-custom:w-96 w-full z-10 flex flex-col bg-transparent justify-center items-center">
    <!-- Book hover container -->
    <div class="flex flex-col justify-center items-center lg-custom:w-64 tall:mt-12 x-tall:mt-16 mt-8">
        <div class="flex-none relative group cursor-pointer transition-all duration-500 ease-out hover:-translate-y-2">
            <img src="<%= book.cover_url %>" alt="Book Cover" class="rounded-lg book-cover lg-custom:w-52 x-tall:w-40 tall:w-36 w-32 transition-all duration-500 ease-out group-hover:brightness-[0.5] group-hover:blur-md group-hover:saturate-50" loading="lazy">
            
            <!-- Dark overlay for better text visibility -->
            <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-25 transition-all duration-500 ease-out rounded-lg"></div>
            
            <!-- Overlay link - appears on hover -->
            <a href="https://openlibrary.org/isbn/<%= book.isbn %>" target="_blank" rel="noopener noreferrer"
               class="absolute inset-0 flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-500 ease-out transform translate-y-4 group-hover:translate-y-0 z-20">
                <span class="text-white font-medium lg-custom:text-base text-base underline decoration-2 underline-offset-4 mb-2 text-center leading-tight filter-none">
                    More on OpenLibrary
                </span>
                <i class="fa fa-external-link-alt text-white lg-custom:text-lg text-base filter-none"></i>
            </a>
        </div>
        
        <!-- book name -->
        <h2 class="lg-custom:text-xl x-tall:text-xl tall:text-lg text-base font-bold text-white mt-3 text-center text-shadow"><%= book.title %></h2>

        <!-- author -->
        <p class="lg-custom:text-base x-tall:text-base tall:text-base text-sm text-white text-center text-shadow"><%= book.author %></p>
    </div>
    </div>
</div>

<!-- right content white container -->
<div class="fixed lg-custom:top-0 top-[50%] right-0 lg-custom:h-screen h-[50%] lg-custom:w-[calc(100%-24rem)] w-full z-20 bg-white rounded-tl-3xl lg-custom:rounded-l-3xl overflow-y-auto lg-custom:p-10 p-8">
    <!-- all content -->
    <div class="max-w-4xl mx-auto flex flex-col">
        <!-- book identity -->
        <div class="flex flex-row gap-4 lg-custom:mt-7 mt-">
            <!-- ISBN -->
            <div class="bg-brown-3 rounded-2xl p-3 flex flex-col">
                <span class="text-brown-2 lg-custom:text-base text-xs font-medium">ISBN</span>
                <span class="text-brown-1 lg-custom:text-base text-xs font-bold"><%= book.isbn %></span>
            </div>
            <!-- Language -->
            <div class="bg-brown-3 rounded-2xl p-3 flex flex-col">
                <span class="text-brown-2 lg-custom:text-base text-xs font-medium">Language</span>
                <span class="text-brown-1 lg-custom:text-base text-xs font-bold"><%= book.language %></span>
            </div>
            <!-- Finished at -->
            <div class="bg-brown-3 rounded-2xl p-3 flex flex-col">
                <span class="text-brown-2 lg-custom:text-base text-xs font-medium">Finished at</span>
                <span class="text-brown-1 lg-custom:text-base text-xs font-bold"><%= book.finished_month_year %></span>
            </div>
        </div>

        <!-- review section -->
        <div>
            <h1 class="font-bold text-brown-2 lg-custom:text-4xl text-3xl mt-7">How Adel would Summarize It</h1>
            <p class="text-justify mt-2 lg-custom:text-base text-xs"><%= book.summary_text %></p>

            <!-- link to openlibrary -->
            <div class="flex flex-row justify-end mt-4">
                <a href="https://openlibrary.org/isbn/<%= book.isbn %>" target="_blank" rel="noopener noreferrer" class="openlibrary-button flex items-center justify-center bg-brown-1 hover:bg-brown-2 text-white font-bold lg-custom:py-2 lg-custom:px-4 px-2 h-7 lg-custom:h-10 lg-custom:text-base text-xs rounded-full transition duration-150 leading-none overflow-hidden relative">
                    More on OpenLibrary
                    <span class="ripple-openlibrary"></span>
                </a>
            </div>
        </div>

        <!-- highlight card section -->
        <div class="mt-7">
            <h1 class="font-bold text-brown-2 lg-custom:text-4xl text-3xl">Highlights</h1>
            <div class="mt-5 highlight-cards-container">
                <% book.highlight_text.forEach((highlight, index) => { %>
                    <div class="highlight-card bg-brown-3 rounded-2xl pt-2 p-6 w-full mb-5 transition-all duration-300 ease-out" data-card-index="<%= index %>">
                        <img src="/assets/quote.png" alt="quote-image" class="lg-custom:w-14 w-10" loading="lazy">
                        <p class="text-justify lg-custom:text-base text-xs"><%= highlight %></p>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
</div>

<style>
/* transitions */
.book-hover-container:hover {
    filter: drop-shadow(0 8px 25px rgba(0, 0, 0, 0.25));
}
.book-hover-container * {
    transition: all 0.5s ease-out;
}

/* link shadow */
.book-hover-container a span,
.book-hover-container a i {
    text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.9), 0 0 20px rgba(0, 0, 0, 0.8);
    filter: none !important;
}

/* link text stays sharp */
.book-hover-container a {
    z-index: 30;
    backdrop-filter: none;
}

/* text elements sharp */
.book-hover-container a * {
    filter: none !important;
    backdrop-filter: none !important;
}

/* OpenLibrary button animations */
.openlibrary-button {
    position: relative;
    transition: all 0.3s ease;
}

.openlibrary-button:hover {
    transform: scale(1.02);
}

.openlibrary-button:active {
    transform: scale(0.98);
}

/* Ripple effect for OpenLibrary button */
.openlibrary-button .ripple-openlibrary {
    position: absolute;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    transform: scale(0);
    animation: ripple-openlibrary-animation 0.6s linear;
    pointer-events: none;
}

@keyframes ripple-openlibrary-animation {
    to {
        transform: scale(4);
        opacity: 0;
    }
}

/* Back button animations */
.back-button {
    position: relative;
    transition: all 0.3s ease;
}

.back-button:hover {
    transform: scale(1.05);
}

.back-button:hover i {
    transform: translateX(-1px);
}

.back-button:active {
    transform: scale(0.95);
}

/* Ripple effect */
.back-button .ripple {
    position: absolute;
    border-radius: 50%;
    background: rgba(139, 119, 101, 0.3);
    transform: scale(0);
    animation: ripple-animation 0.6s linear;
    pointer-events: none;
}

@keyframes ripple-animation {
    to {
        transform: scale(4);
        opacity: 0;
    }
}

/* Highlight card animations */
.highlight-card {
    position: relative;
    cursor: pointer;
    z-index: 1;
}

.highlight-card:hover {
    transform: translateY(-8px) scale(1.02);
    z-index: 10;
}

/* Push down the card below when hovering */
.highlight-card:hover + .highlight-card {
    transform: translateY(4px);
}

/* Push up the previous card when hovering current card */
.highlight-card:has(+ .highlight-card:hover) {
    transform: translateY(-4px);
}

/* Alternative approach using JavaScript for better browser compatibility */
.highlight-card.hovered {
    transform: translateY(-8px) scale(1.02);
    z-index: 10;
}

.highlight-card.push-down {
    transform: translateY(4px);
}

.highlight-card.push-up {
    transform: translateY(-4px);
}
</style>

<script>
// highlight card animations
document.addEventListener('DOMContentLoaded', function() {
    const cards = document.querySelectorAll('.highlight-card');
    
    cards.forEach((card, index) => {
        card.addEventListener('mouseenter', function() {
            // hover class to current card
            this.classList.add('hovered');
            
            // push down next card
            if (index < cards.length - 1) {
                cards[index + 1].classList.add('push-down');
            }
            
            // push up previous card
            if (index > 0) {
                cards[index - 1].classList.add('push-up');
            }
        });
        
        card.addEventListener('mouseleave', function() {
            // remove all classes from current card
            this.classList.remove('hovered');
            
            // remove push classes from adjacent cards
            if (index < cards.length - 1) {
                cards[index + 1].classList.remove('push-down');
            }
            
            if (index > 0) {
                cards[index - 1].classList.remove('push-up');
            }
        });
    });
    
    // back button ripple effect
    const backButton = document.querySelector('.back-button');
    if (backButton) {
        backButton.addEventListener('click', function(e) {
            const ripple = this.querySelector('.ripple');
            const rect = this.getBoundingClientRect();
            const size = Math.max(rect.width, rect.height);
            const x = e.clientX - rect.left - size / 2;
            const y = e.clientY - rect.top - size / 2;
            
            ripple.style.width = ripple.style.height = size + 'px';
            ripple.style.left = x + 'px';
            ripple.style.top = y + 'px';
            ripple.classList.add('animate');
            
            setTimeout(() => {
                ripple.classList.remove('animate');
            }, 600);
        });
    }
    
    // OpenLibrary button ripple effect
    const openLibraryButtons = document.querySelectorAll('.openlibrary-button');
    openLibraryButtons.forEach(button => {
        button.addEventListener('click', function(e) {
            const ripple = this.querySelector('.ripple-openlibrary');
            const rect = this.getBoundingClientRect();
            const size = Math.max(rect.width, rect.height);
            const x = e.clientX - rect.left - size / 2;
            const y = e.clientY - rect.top - size / 2;
            
            ripple.style.width = ripple.style.height = size + 'px';
            ripple.style.left = x + 'px';
            ripple.style.top = y + 'px';
            ripple.classList.add('animate');
            
            setTimeout(() => {
                ripple.classList.remove('animate');
            }, 600);
        });
    });
});
</script>

</body>