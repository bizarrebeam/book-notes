<%- include('partials/header.ejs') %>

<!-- background image -->
<div class="h-screen fixed inset-0 overflow-hidden z-0">
    <img src="<%= book.cover_url %>" alt="Book Cover Background" class="h-full background-blur" loading="lazy">
</div>

<!-- back button -->
<a href="/" class="absolute top-7 left-7 bg-white rounded-full lg-custom:w-10 lg-custom:h-10 w-8 h-8 flex items-center justify-center shadow-lg hover:bg-gray-200 active:bg-gray-300 transition cursor-pointer z-30">
    <i class="fa fa-arrow-left lg-custom:text-xl text-lg text-brown-1"></i>
</a>

<!-- left content -->
<div class="fixed top-0 left-0 lg-custom:h-screen h-[45%] lg-custom:w-96 w-full z-10 flex flex-col bg-transparent justify-center items-center">
    <!-- Book hover container -->
    <div class="flex flex-col justify-center items-center lg-custom:w-64 tall:mt-12 x-tall:mt-16 mt-8">
        <div class="flex-none relative group cursor-pointer transition-all duration-500 ease-out hover:-translate-y-2">
            <img src="<%= book.cover_url %>" alt="Book Cover" class="rounded-lg book-cover lg-custom:w-52 x-tall:w-40 tall:w-36 w-32 transition-all duration-500 ease-out group-hover:brightness-[0.5] group-hover:blur-md group-hover:saturate-50" loading="lazy">
            
            <!-- Dark overlay for better text visibility -->
            <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-25 transition-all duration-500 ease-out rounded-lg"></div>
            
            <!-- Overlay link - appears on hover -->
            <a href="https://openlibrary.org/isbn/<%= book.isbn %>" 
               class="absolute inset-0 flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-500 ease-out transform translate-y-4 group-hover:translate-y-0 z-20">
                <span class="text-white font-medium lg-custom:text-base text-base underline decoration-2 underline-offset-4 mb-2 text-center leading-tight filter-none">
                    More on OpenLibrary
                </span>
                <i class="fa fa-external-link-alt text-white lg-custom:text-lg text-base filter-none"></i>
            </a>
        </div>
        
        <!-- book name -->
        <h2 class="lg-custom:text-xl x-tall:text-xl tall:text-lg text-base font-bold text-white mt-3 text-center text-shadow"><%= book.title %></h2>

        <!-- author -->
        <p class="lg-custom:text-base x-tall:text-base tall:text-base text-sm text-white text-center text-shadow"><%= book.author %></p>
    </div>
    </div>
</div>

<!-- right content white container -->
<div class="fixed lg-custom:top-0 top-[50%] right-0 lg-custom:h-screen h-[50%] lg-custom:w-[calc(100%-24rem)] w-full z-20 bg-white rounded-tl-3xl lg-custom:rounded-l-3xl overflow-y-auto lg-custom:p-10 p-8">
    <!-- all content -->
    <div class="max-w-4xl mx-auto flex flex-col">
        <!-- book identity -->
        <div class="flex flex-row gap-4 lg-custom:mt-7 mt-3">
            <!-- ISBN -->
            <div class="bg-brown-3 rounded-2xl p-3 flex flex-col">
                <span class="text-brown-2 lg-custom:text-base text-xs font-medium">ISBN</span>
                <span class="text-brown-1 lg-custom:text-base text-xs font-bold"><%= book.isbn %></span>
            </div>
            <!-- Language -->
            <div class="bg-brown-3 rounded-2xl p-3 flex flex-col">
                <span class="text-brown-2 lg-custom:text-base text-xs font-medium">Language</span>
                <span class="text-brown-1 lg-custom:text-base text-xs font-bold"><%= book.language %></span>
            </div>
            <!-- Finished at -->
            <div class="bg-brown-3 rounded-2xl p-3 flex flex-col">
                <span class="text-brown-2 lg-custom:text-base text-xs font-medium">Finished at</span>
                <span class="text-brown-1 lg-custom:text-base text-xs font-bold"><%= book.finished_month_year %></span>
            </div>
        </div>

        <!-- review section -->
        <div>
            <h1 class="font-bold text-brown-2 lg-custom:text-4xl text-3xl mt-7">How Adel would Summarize It</h1>
            <p class="text-justify mt-2 lg-custom:text-base text-xs"><%= book.summary_text %></p>

            <!-- link to openlibrary -->
            <div class="flex flex-row justify-end mt-4">
                <a href="https://openlibrary.org/isbn/<%= book.isbn %>" class="flex items-center justify-center bg-brown-1 hover:bg-brown-2 text-white font-bold lg-custom:py-2 lg-custom:px-4 px-2 h-7 lg-custom:h-10 lg-custom:text-base text-xs rounded-full transition duration-150 leading-none">more on openlibrary</a>
            </div>
        </div>

        <!-- highlight card section -->
        <div class="mt-7">
            <h1 class="font-bold text-brown-2 lg-custom:text-4xl text-3xl">Highlights</h1>
            <div class="mt-5">
                <% book.highlight_text.forEach(highlight => { %>
                    <div class="bg-brown-3 rounded-2xl pt-2 p-6 w-full mb-5">
                        <img src="/assets/quote.png" alt="quote-image" class="lg-custom:w-14 w-10" loading="lazy">
                        <p class="text-justify lg-custom:text-base text-xs"><%= highlight %></p>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
</div>

<style>
/* transitions */
.book-hover-container:hover {
    filter: drop-shadow(0 8px 25px rgba(0, 0, 0, 0.25));
}
.book-hover-container * {
    transition: all 0.5s ease-out;
}

/* link shadow */
.book-hover-container a span,
.book-hover-container a i {
    text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.9), 0 0 20px rgba(0, 0, 0, 0.8);
    filter: none !important;
}

/* link text stays sharp */
.book-hover-container a {
    z-index: 30;
    backdrop-filter: none;
}

/* text elements sharp */
.book-hover-container a * {
    filter: none !important;
    backdrop-filter: none !important;
}
</style>

</body>