<%- include('partials/header.ejs') %>

<div class="min-h-screen bg-brown-3 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
        <!-- Back to public site button -->
        <div class="mb-8">
            <a href="/" class="inline-flex items-center text-brown-1 hover:text-brown-2 transition duration-150">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Back to Site
            </a>
        </div>

        <!-- Compose container -->
        <div class="bg-white rounded-2xl shadow-xl p-8 border border-brown-2">
            <div class="text-center mb-8">
                <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-brown-1 mb-2">
                    <% if (typeof editMode !== 'undefined' && editMode) { %>
                        Edit Book Entry
                    <% } else { %>
                        Compose New Entry
                    <% } %>
                </h1>
                <p class="text-brown-2 text-xs sm:text-sm">
                    <% if (typeof editMode !== 'undefined' && editMode) { %>
                        Update your book information
                    <% } else { %>
                        Add a new book to your collection
                    <% } %>
                </p>
            </div>
            
            <form action="<% if (typeof editMode !== 'undefined' && editMode) { %>/admin/update/<%= book.book_id %><% } else { %>/compose<% } %>" method="POST" class="space-y-8">

                <!-- Book Title and Author Name Row -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label for="title" class="block text-xs sm:text-sm font-medium text-brown-1 mb-2">
                            Book Title
                        </label>
                        <input 
                            type="text" 
                            id="title" 
                            name="title" 
                            required 
                            autofocus
                            value="<% if (typeof book !== 'undefined' && book) { %><%= book.title %><% } %>"
                            class="w-full px-3 sm:px-4 py-2 sm:py-3 text-sm sm:text-base bg-white border-2 border-brown-2 rounded-xl text-brown-1 placeholder-brown-2 focus:outline-none focus:ring-0 focus:border-brown-1 transition duration-200 hover:border-brown-1"
                            placeholder="Enter book title"
                        >
                    </div>
                    <div>
                        <label for="author" class="block text-xs sm:text-sm font-medium text-brown-1 mb-2">
                            Author Name
                        </label>
                        <input 
                            type="text" 
                            id="author" 
                            name="author" 
                            required
                            value="<% if (typeof book !== 'undefined' && book) { %><%= book.author %><% } %>"
                            class="w-full px-3 sm:px-4 py-2 sm:py-3 text-sm sm:text-base bg-white border-2 border-brown-2 rounded-xl text-brown-1 placeholder-brown-2 focus:outline-none focus:ring-0 focus:border-brown-1 transition duration-200 hover:border-brown-1"
                            placeholder="Enter author name"
                        >
                    </div>
                </div>

                <!-- Book ISBN, Language, and Finished At Row -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <label for="isbn" class="block text-xs sm:text-sm font-medium text-brown-1 mb-2">
                            Book ISBN
                        </label>
                        <input 
                            type="text" 
                            id="isbn" 
                            name="isbn" 
                            value="<% if (typeof book !== 'undefined' && book) { %><%= book.isbn %><% } %>"
                            class="w-full px-3 sm:px-4 py-2 sm:py-3 text-sm sm:text-base bg-white border-2 border-brown-2 rounded-xl text-brown-1 placeholder-brown-2 focus:outline-none focus:ring-0 focus:border-brown-1 transition duration-200 hover:border-brown-1"
                            placeholder="Enter ISBN"
                        >
                    </div>
                    <div>
                        <label for="language" class="block text-xs sm:text-sm font-medium text-brown-1 mb-2">
                            Book Language
                        </label>
                        <input 
                            type="text" 
                            id="language" 
                            name="language" 
                            value="<% if (typeof book !== 'undefined' && book) { %><%= book.language %><% } %>"
                            class="w-full px-3 sm:px-4 py-2 sm:py-3 text-sm sm:text-base bg-white border-2 border-brown-2 rounded-xl text-brown-1 placeholder-brown-2 focus:outline-none focus:ring-0 focus:border-brown-1 transition duration-200 hover:border-brown-1"
                            placeholder="Enter language"
                        >
                    </div>
                    <div>
                        <label for="finished-at" class="block text-xs sm:text-sm font-medium text-brown-1 mb-2">
                            Finished At
                        </label>
                        <input 
                            type="text" 
                            id="finished-at" 
                            name="finished_at" 
                            value="<% if (typeof book !== 'undefined' && book) { %><%= book.finished_month_year %><% } %>"
                            class="w-full px-3 sm:px-4 py-2 sm:py-3 text-sm sm:text-base bg-white border-2 border-brown-2 rounded-xl text-brown-1 placeholder-brown-2 focus:outline-none focus:ring-0 focus:border-brown-1 transition duration-200 hover:border-brown-1"
                            placeholder="e.g., June 2024"
                        >
                    </div>
                </div>

                <!-- Summary Section -->
                <div>
                    <label for="summarize" class="block text-xs sm:text-sm font-medium text-brown-1 mb-2">
                        Summarize It
                    </label>
                    <textarea 
                        id="summarize" 
                        name="summarize" 
                        rows="6" 
                        class="w-full px-3 sm:px-4 py-2 sm:py-3 text-sm sm:text-base bg-white border-2 border-brown-2 rounded-xl text-brown-1 placeholder-brown-2 focus:outline-none focus:ring-0 focus:border-brown-1 transition duration-200 hover:border-brown-1 resize-none"
                        placeholder="Write your summary here..."
                    ><% if (typeof book !== 'undefined' && book) { %><%= book.summary_text %><% } else { %>This book left Adel wordless… still no review in sight.<% } %></textarea>
                </div>

                <!-- Highlights Section -->
                <div>
                    <label class="block text-xs sm:text-sm font-medium text-brown-1 mb-4">
                        Book Highlights
                    </label>
                    <div id="highlight-container" class="space-y-4">
                        <% if (typeof book !== 'undefined' && book && book.highlight_text && book.highlight_text.length > 0) { %>
                            <% book.highlight_text.forEach((highlight, index) => { %>
                                <div class="highlight-item">
                                    <div class="flex justify-between items-center mb-1">
                                        <label for="highlight-<%= index %>" class="block text-xs font-medium text-brown-2">
                                            Highlight <%= index + 1 %>
                                        </label>
                                        <% if (index > 0) { %>
                                            <button type="button" class="text-red-500 hover:text-red-700 text-xl font-bold w-6 h-6 flex items-center justify-center rounded-full hover:bg-red-100 transition duration-200" onclick="this.parentElement.parentElement.remove(); updateHighlightLabels();">×</button>
                                        <% } %>
                                    </div>
                                    <input 
                                        type="text" 
                                        id="highlight-<%= index %>" 
                                        name="highlights[]" 
                                        value="<%= highlight %>"
                                        class="w-full px-3 sm:px-4 py-2 sm:py-3 text-sm sm:text-base bg-white border-2 border-brown-2 rounded-xl text-brown-1 placeholder-brown-2 focus:outline-none focus:ring-0 focus:border-brown-1 transition duration-200 hover:border-brown-1"
                                        placeholder="Enter your highlight"
                                    >
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="highlight-item">
                                <div class="flex justify-between items-center mb-1">
                                    <label for="highlight-0" class="block text-xs font-medium text-brown-2">
                                        Highlight 1
                                    </label>
                                </div>
                                <input 
                                    type="text" 
                                    id="highlight-0" 
                                    name="highlights[]" 
                                    value="The book was such a page-turner that Adel hasn't highlighted a single line yet."
                                    class="w-full px-3 sm:px-4 py-2 sm:py-3 text-sm sm:text-base bg-white border-2 border-brown-2 rounded-xl text-brown-1 placeholder-brown-2 focus:outline-none focus:ring-0 focus:border-brown-1 transition duration-200 hover:border-brown-1"
                                    placeholder="Enter your highlight"
                                >
                            </div>
                        <% } %>
                    </div>
                    
                    <!-- Add Highlight Button -->
                    <button 
                        type="button" 
                        onclick="addHighlightInput()" 
                        class="mt-4 bg-brown-2 text-white py-2 px-4 sm:px-6 text-sm sm:text-base rounded-xl font-medium hover:bg-brown-1 focus:outline-none focus:ring-4 focus:ring-brown-2 focus:ring-opacity-50 transition duration-200 transform hover:scale-[1.02] active:scale-[0.98]"
                    >
                        Add Highlight
                    </button>
                </div>

                <!-- Submit Button -->
                <div class="flex justify-center pt-6">
                    <button 
                        type="submit" 
                        class="bg-brown-1 text-white py-2 sm:py-3 px-6 sm:px-8 text-sm sm:text-base rounded-xl font-medium hover:bg-brown-2 focus:outline-none focus:ring-4 focus:ring-brown-1 focus:ring-opacity-50 transition duration-200 transform hover:scale-[1.02] active:scale-[0.98] shadow-lg"
                    >
                        <% if (typeof editMode !== 'undefined' && editMode) { %>
                            Update Entry
                        <% } else { %>
                            Compose Entry
                        <% } %>
                    </button>
                </div>
            </form>
        </div>

        
    </div>
</div>

<!-- adding more than one highlight -->
<script>
    <% if (typeof book !== 'undefined' && book && book.highlight_text) { %>
        let highlightCount = <%= book.highlight_text.length %>;
    <% } else { %>
        let highlightCount = 1;
    <% } %>

    function addHighlightInput() {
        const highlightContainer = document.getElementById('highlight-container');
        
        const newHighlightItem = document.createElement('div');
        newHighlightItem.classList.add('highlight-item');
        
        const headerDiv = document.createElement('div');
        headerDiv.classList.add('flex', 'justify-between', 'items-center', 'mb-1');
        
        const newLabel = document.createElement('label');
        newLabel.textContent = `Highlight ${highlightCount + 1}`;
        newLabel.classList.add('block', 'text-xs', 'font-medium', 'text-brown-2');
        newLabel.setAttribute('for', `highlight-${highlightCount}`);

        const removeButton = document.createElement('button');
        removeButton.type = 'button';
        removeButton.innerHTML = '×';
        removeButton.classList.add('text-red-500', 'hover:text-red-700', 'text-xl', 'font-bold', 'w-6', 'h-6', 'flex', 'items-center', 'justify-center', 'rounded-full', 'hover:bg-red-100', 'transition', 'duration-200');
        removeButton.onclick = function() {
            newHighlightItem.remove();
            updateHighlightLabels();
        };

        const newInput = document.createElement('input');
        newInput.type = 'text';
        newInput.name = 'highlights[]';
        newInput.id = `highlight-${highlightCount}`;
        newInput.classList.add('w-full', 'px-3', 'sm:px-4', 'py-2', 'sm:py-3', 'text-sm', 'sm:text-base', 'bg-white', 'border-2', 'border-brown-2', 'rounded-xl', 'text-brown-1', 'placeholder-brown-2', 'focus:outline-none', 'focus:ring-0', 'focus:border-brown-1', 'transition', 'duration-200', 'hover:border-brown-1');
        newInput.placeholder = 'Enter your highlight';

        headerDiv.appendChild(newLabel);
        headerDiv.appendChild(removeButton);
        newHighlightItem.appendChild(headerDiv);
        newHighlightItem.appendChild(newInput);
        highlightContainer.appendChild(newHighlightItem);

        highlightCount++;
    }

    function updateHighlightLabels() {
        const highlightItems = document.querySelectorAll('.highlight-item');
        highlightItems.forEach((item, index) => {
            const label = item.querySelector('label');
            if (label) {
                label.textContent = `Highlight ${index + 1}`;
            }
        });
        highlightCount = highlightItems.length;
    }
</script>

</body>